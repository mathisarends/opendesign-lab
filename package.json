{
  "name": "opendesign-lab",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"test/*.test.mjs\"",
    "export": "node exporter/export.mjs",
    "maximus:export": "node exporter/export.mjs --config examples/maximus/opendesign.config.json",
    "maximus:check": "node exporter/export.mjs --config examples/maximus/opendesign.config.json --check",
    "maximus:verify": "node examples/maximus/verify.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3"
  }
}
